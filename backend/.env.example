# Server Configuration
PORT=5000
NODE_ENV=production
SERVER_URL=http://localhost:5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://admin:secure_password@cluster0.abcde.mongodb.net/sjc_birthday_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/sjc_birthday_db

# College Leadership Configuration
RECTOR_NAME=Rev. Dr. Pavulraj Michael SJ
PRINCIPAL_NAME=Rev. Dr. K. Arockiam SJ
SECRETARY_NAME=Rev. Dr. M. Arockiasamy Xavier SJ

# Automated Midnight Cron Schedule (Default: Every day at 00:01 AM IST)
CRON_SCHEDULE=0 1 0 * * *
CRON_TIMEZONE=Asia/Kolkata

# WhatsApp Dispatch Configuration
# Options: BAILEYS, CLOUDS_API, WEBHOOK_GATEWAY
WHATSAPP_PROVIDER=BAILEYS
WHATSAPP_SESSION_PATH=./whatsapp-session
WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_TOKEN=

# Admin Authentication Token (Optional for securing Admin routes)
ADMIN_SECRET_KEY=sjc_secret_admin_token_2026
