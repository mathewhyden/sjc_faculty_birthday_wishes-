# ==============================================================================
# SJC BIRTHDAY BACKEND - PRODUCTION ENVIRONMENT TEMPLATE (.env)
# ==============================================================================

# Server Network Settings
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Base URL used for serving public card images to WhatsApp Meta Graph API
# In production on Render/Railway: e.g. https://sjc-birthday-backend.onrender.com
SERVER_BASE_URL=http://localhost:5000

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sjc_birthday_db?retryWrites=true&w=majority

# ==============================================================================
# META OFFICIAL WHATSAPP CLOUD API CONFIGURATION (Graph API v19.0)
# ==============================================================================
# WhatsApp Business Account (WABA) Phone Number ID from Meta Developers Dashboard
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# System User Permanent Access Token with whatsapp_business_messaging scope
META_WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token_here

# Meta Graph API Base URL & Version
META_GRAPH_API_VERSION=v19.0

# ==============================================================================
# TEST & SAFETY MODE SWITCH
# ==============================================================================
# If true: All automated/manual messages are redirected ONLY to TEST_PHONE_NUMBER
# If false: Live production mode sending to actual faculty mobile numbers
TEST_MODE=true
TEST_PHONE_NUMBER=919876543210

# ==============================================================================
# AUTOMATED CRON SCHEDULER (Daily 8:00 AM IST)
# ==============================================================================
# Default: Runs at 8:00 AM every day ('0 0 8 * * *')
CRON_SCHEDULE=0 0 8 * * *
CRON_TIMEZONE=Asia/Kolkata

# ==============================================================================
# ST. JOSEPH'S COLLEGE LEADERSHIP DIRECTORY
# ==============================================================================
RECTOR_NAME=Rev. Dr. Pavulraj Michael SJ
PRINCIPAL_NAME=Rev. Dr. K. Arockiam SJ
SECRETARY_NAME=Rev. Dr. M. Arockiasamy Xavier SJ
